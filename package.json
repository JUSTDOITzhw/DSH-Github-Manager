{
  "name": "dsh-github-manager",
  "version": "0.4.2",
  "description": "Bind a GitHub account to dsh and manage repositories from a sidebar panel or by @-mentioning a repository in the composer: list, create, upload projects or single files, and delete. While an account is bound it also exposes the official GitHub MCP server to the conversation as mcp__github__* tools.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/smoke.mjs"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.2-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web"
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "@deepseek-ai/dsh-mcp-client": ">=0.1.2-rc.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-mcp-client": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "github",
    "repository",
    "git",
    "mcp"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JUSTDOITzhw/DSH-Github-Manager.git"
  },
  "homepage": "https://github.com/JUSTDOITzhw/DSH-Github-Manager#readme",
  "bugs": {
    "url": "https://github.com/JUSTDOITzhw/DSH-Github-Manager/issues"
  }
}
